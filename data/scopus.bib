	journal = {IEEE Transactions on Circuits and Systems II: Express Briefs},
	volume = {69},
	number = {10},
	pages = {4068 - 4072},
	doi = {10.1109/TCSII.2022.3184703},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133741231&doi=10.1109%2FTCSII.2022.3184703&partnerID=40&md5=3bb2d99659deaff7c163d69a4a0b57b2},
	affiliations = {College of Information Science and Electronic Engineering, Zhejiang University, Hangzhou, Zhejiang, China; City University of Hong Kong, Department of Electrical Engineering, Hong Kong, Hong Kong},
	abstract = {Polynomial multiplication is the key and time-consuming operation among various operators in Post-Quantum Cryptography (PQC), which aims to find quantum-resistant algorithms to prevent attacks launched by quantum computers. Number Theoretic Transform (NTT) is an efficient algorithm that can accelerate the polynomial multiplication from mathcal {O}(n^{2}) to mathcal {O}(nlog(n)). In this brief, we present a pipelined NTT (PipeNTT) hardware architecture in FPGA to achieve high throughput with fewer hardware resources. The dataflow and the butterfly unit are optimized to minimize the latency. To fulfil the proposed dataflow, a Block RAM (BRAM) based reordering unit is designed to further reduce the hardware resource. Moreover, our architecture can also be applied to Inverse-NTT (INTT). Compared to state-of-the-art parallel designs, our design achieves a 30% lower area-time product with 3x less memory space requirement. © 2004-2012 IEEE.},
	author_keywords = {FPGA; number theoretic transform (NTT); pipelined design; Post-quantum cryptography (PQC)},
	keywords = {Field programmable gate arrays (FPGA); Integrated circuit design; Memory architecture; Pipelines; Quantum cryptography; Random access storage; Delay; Field programmable gate array; Field programmables; Hardware; Memory-management; Number theoretic transform; Number-theoretic transforms; Pipelined design; Post quantum cryptography; Post-quantum cryptography; Programmable gate array; Random access memory; Mathematical transformations},
	correspondence_address = {K. Huang; Zhejiang University, College of Information Science and Electronic Engineering, Hangzhou, 310058, China; email: huangkejie@zju.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
